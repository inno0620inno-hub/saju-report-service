# -*- 사주 리포트 서비스 환경변수 예시 파일 -*-
# 사용법: cp .env.example .env  후 실제 값으로 채워넣기

# --- AI 해석문 생성 (필수) ---
ANTHROPIC_API_KEY=

# --- 관리자 페이지 (/admin) 로그인 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- 이메일 발송 (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SENDER_NAME=사주 명식 리포트

# --- 카카오 알림톡 (Solapi) ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_SENDER_KEY=
ALIMTALK_TEMPLATE_ID=
SENDER_PHONE=

# --- PDF 다운로드 링크에 사용할 공개 서버 주소 ---
PUBLIC_PDF_BASE_URL=https://YOUR_SERVER_DOMAIN/files

# --- 생성된 PDF 저장 경로 ---
OUTPUT_DIR=generated_reports
